# Frontend environment variables.
# Copy this file to .env.local and adjust as needed. .env.local is gitignored.

# Public base URL of the FastAPI backend. The browser uses this for every API call (see frontend/src/lib/api.ts).
# NEXT_PUBLIC_* values are baked into the JS bundle at build time; rebuild after changing.
# Both the Docker Compose stack and native dev expose the backend on host port 8000, so http://localhost:8000 works for both.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
