# Backend environment variables.
# Copy to .env and fill in real values. .env is gitignored.

# Application
ENV=dev
LOG_LEVEL=INFO

# JWT (required — app refuses to start without JWT_SECRET)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-random-64-char-hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000

# Uploads (relative to where uvicorn is started)
UPLOAD_DIR=./uploads

# Database (required — app refuses to start without DATABASE_URL)
DATABASE_URL=postgresql+psycopg://student:student@localhost:5433/student_eco
