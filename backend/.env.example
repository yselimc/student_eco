# Backend environment variables.
# Copy this file to .env and fill in real values. .env is gitignored.

# Runtime mode flag — read by the app for log formatting and any future env-gated behavior. Use "dev" locally, "prod" when deploying.
ENV=dev

# Python logging level. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Secret used to sign JWT access tokens. The app refuses to start if this is missing or empty.
# Generate with: openssl rand -hex 32     (or: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=replace-with-a-64-char-random-hex-string

# Algorithm used to sign JWTs. HS256 matches our symmetric-secret setup; don't change unless you also switch key types.
JWT_ALGORITHM=HS256

# How long an issued access token stays valid, in days. There is no refresh token in v1.
JWT_EXPIRE_DAYS=7

# Comma-separated list of origins allowed by FastAPI CORS. Whitespace is stripped.
# Add every URL the frontend is served from. Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory the backend writes uploads (PDFs, listing images, avatars) into.
# Relative paths resolve from where uvicorn is started. In Docker this maps to /app/uploads (a named volume).
UPLOAD_DIR=./uploads

# Postgres connection URL. The app refuses to start if this is missing.
# Use the SQLAlchemy dialect prefix `postgresql+psycopg://` (psycopg v3 driver).
# Pick ONE of the examples below (uncomment it) based on how you run the backend:
#   Docker Compose — backend container reaches Postgres via the `db` service hostname:
# DATABASE_URL=postgresql+psycopg://student:student@db:5432/student_eco
#   Native dev — uvicorn on the host reaches Postgres on localhost:
# DATABASE_URL=postgresql+psycopg://student:student@localhost:5432/student_eco
